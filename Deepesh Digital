<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deepesh Digital</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<style>
body {
  margin: 0;
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(135deg,#eef2ff,#fdf2f8);
  color: #111;
}

/* HEADER */
header {
  display:flex;
  justify-content:space-between;
  padding:20px 40px;
  background:white;
  border-bottom:2px solid #0f172a;
}

.logo { font-weight:600; font-size:22px; }

/* HERO */
.hero {
  text-align:center;
  padding:80px 20px;
}

.hero h1 { font-size:40px; }

/* BUTTONS */
.btn {
  padding:12px 20px;
  margin:8px;
  border:none;
  border-radius:8px;
  color:white;
  cursor:pointer;
}

.whatsapp { background:#25D366; }
.instagram { background:#E1306C; }
.facebook { background:#1877F2; }
.linkedin { background:#0077B5; }

/* SECTION */
section {
  padding:50px 20px;
  border-bottom:2px solid #0f172a;
}

/* GRID */
.grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.card {
  background:white;
  padding:20px;
  border-radius:12px;
  border:2px solid #0f172a;
  transition:0.3s;
}

.card:hover {
  transform:translateY(-10px);
}

/* IMAGE */
img {
  width:100%;
  border-radius:10px;
}

/* FORM */
form input, form textarea {
  width:80%;
  padding:10px;
  margin:10px;
}

/* POPUP */
.popup {
  position:fixed;
  top:20px;
  right:20px;
  background:green;
  color:white;
  padding:15px;
  display:none;
}
</style>
</head>

<body>

<header>
  <div class="logo">🤖 Deepesh Digital</div>
</header>

<!-- HERO -->
<section class="hero">
  <h1>Make Your Business Online 🚀</h1>
  <p>I help businesses grow with websites & digital marketing</p>

  <!-- ONLY ONE BUTTON ROW -->
  <div>
    <a href="https://wa.me/919399816768?text=Hi I need digital marketing">
      <button class="btn whatsapp">WhatsApp</button>
    </a>

    <a href="https://instagram.com/YOUR_INSTAGRAM" target="_blank">
      <button class="btn instagram">Instagram</button>
    </a>

    <a href="https://facebook.com/YOUR_FACEBOOK" target="_blank">
      <button class="btn facebook">Facebook</button>
    </a>

    <a href="https://linkedin.com/in/YOUR_LINKEDIN" target="_blank">
      <button class="btn linkedin">LinkedIn</button>
    </a>
  </div>
</section>

<!-- ABOUT -->
<section>
  <h2>About Me</h2>
  <p>I create high converting websites and manage social media to help businesses generate leads online.</p>
</section>

<!-- SERVICES -->
<section>
  <h2>My Services</h2>
  <div class="grid">

    <div class="card">
      <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085">
      <h3>Website Development</h3>
      <p>Modern, responsive websites to grow your business online.</p>
    </div>

    <div class="card">
      <img src="https://images.unsplash.com/photo-1557838923-2985c318be48">
      <h3>Digital Marketing</h3>
      <p>Boost your online presence and reach more customers.</p>
    </div>

    <div class="card">
      <img src="https://images.unsplash.com/photo-1611162616475-46b635cb6868">
      <h3>Social Media Setup</h3>
      <p>Instagram & Facebook pages to connect with your audience.</p>
    </div>

  </div>
</section>

<!-- WHY CHOOSE -->
<section>
  <h2>Why Choose Me</h2>
  <p>✔ Fast Delivery</p>
  <p>✔ Affordable Pricing</p>
  <p>✔ Professional Design</p>
  <p>✔ Lead Generation Focus</p>
</section>

<!-- PORTFOLIO -->
<section>
  <h2>Demo Work</h2>
  <div class="grid">
    <div class="card">Business Website Demo</div>
    <div class="card">Instagram Growth Demo</div>
    <div class="card">Facebook Page Demo</div>
  </div>
</section>

<!-- CONTACT -->
<section>
  <h2>Contact Me</h2>

  <form id="form">
    <input type="text" placeholder="Your Name" required><br>
    <input type="text" placeholder="Phone Number" required><br>
    <textarea placeholder="Your Requirement"></textarea><br>
    <button class="btn whatsapp">Submit</button>
  </form>
</section>

<div class="popup" id="popup">✅ Enquiry Sent!</div>

<script>
document.getElementById("form").addEventListener("submit", function(e){
  e.preventDefault();
  document.getElementById("popup").style.display="block";
  setTimeout(()=>{document.getElementById("popup").style.display="none";},3000);
});
</script>

</body>
</html>
