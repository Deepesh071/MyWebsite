<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deepesh Digital</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<style>
body {
  margin: 0;
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(135deg,#eef2ff,#fdf2f8);
  color: #111;
  scroll-behavior: smooth;
}

/* HEADER */
header {
  display: flex;
  justify-content: space-between;
  padding: 20px 40px;
  background: white;
  border-bottom: 2px solid #0f172a;
  position: sticky;
  top: 0;
}

.logo {
  font-weight: 600;
  font-size: 22px;
}

nav a {
  margin: 0 10px;
  text-decoration: none;
  color: #111;
}

/* HERO */
.hero {
  text-align: center;
  padding: 100px 20px;
}

.hero h1 {
  font-size: 42px;
}

/* BUTTONS */
.btn {
  padding: 12px 25px;
  border-radius: 8px;
  margin: 8px;
  border: none;
  cursor: pointer;
  color: white;
  transition: 0.3s;
}

.btn:hover {
  transform: scale(1.05);
}

.whatsapp { background:#25D366; }
.instagram { background:#E1306C; }
.facebook { background:#1877F2; }
.linkedin { background:#0077B5; }

/* SECTION */
section {
  padding: 60px 20px;
  border-bottom: 2px solid #0f172a;
}

/* CARDS */
.services, .portfolio {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
  gap: 20px;
}

.card {
  background: white;
  padding: 20px;
  border: 2px solid #0f172a;
  border-radius: 12px;
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-10px);
}

/* FORM */
form input, form textarea {
  width: 80%;
  padding: 10px;
  margin: 10px;
}

/* POPUP */
.popup {
  position: fixed;
  top: 20px;
  right: 20px;
  background: green;
  color: white;
  padding: 15px;
  display: none;
}

/* FOOTER */
footer {
  text-align: center;
  padding: 20px;
}

/* FLOAT BUTTON */
.float-btn {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #25D366;
  padding: 15px;
  border-radius: 50%;
  color: white;
  text-decoration: none;
}
</style>
</head>

<body>

<header>
  <div class="logo">🤖 Deepesh Digital</div>
  <nav>
    <a href="#about">About</a>
    <a href="#services">Services</a>
    <a href="#portfolio">Portfolio</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<!-- HERO -->
<section class="hero">
  <h1>Grow Your Business Online 🚀</h1>
  <p>Website | Instagram | Facebook | LinkedIn | Lead Generation</p>

  <a href="https://wa.me/919399816768?text=Hi%20I%20need%20digital%20marketing">
    <button class="btn whatsapp">💬 WhatsApp</button>
  </a>

  <a href="https://instagram.com/YOUR_INSTAGRAM" target="_blank">
    <button class="btn instagram">📸 Instagram</button>
  </a>

  <a href="https://facebook.com/YOUR_FACEBOOK" target="_blank">
    <button class="btn facebook">📘 Facebook</button>
  </a>

  <a href="https://linkedin.com/in/YOUR_LINKEDIN" target="_blank">
    <button class="btn linkedin">💼 LinkedIn</button>
  </a>
</section>

<!-- ABOUT -->
<section id="about">
  <h2>About Me</h2>
  <p>I help businesses grow online by creating websites, social media presence and generating leads.</p>
</section>

<!-- SERVICES -->
<section id="services">
  <h2>Services</h2>
  <div class="services">
    <div class="card">Website Development</div>
    <div class="card">Instagram Growth</div>
    <div class="card">Facebook Page Setup</div>
    <div class="card">LinkedIn Branding</div>
    <div class="card">Lead Generation</div>
  </div>
</section>

<!-- PORTFOLIO -->
<section id="portfolio">
  <h2>Portfolio</h2>
  <div class="portfolio">
    <div class="card">Project 1</div>
    <div class="card">Project 2</div>
    <div class="card">Project 3</div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact">
  <h2>Contact Me</h2>

  <form id="form">
    <input type="text" placeholder="Your Name" required><br>
    <input type="text" placeholder="Phone Number" required><br>
    <textarea placeholder="Your Requirement"></textarea><br>
    <button class="btn whatsapp">Submit</button>
  </form>
</section>

<div class="popup" id="popup">✅ Enquiry Sent!</div>

<footer>
  © 2026 Deepesh Digital
</footer>

<a class="float-btn" href="https://wa.me/919399816768?text=Hi%20I%20need%20service">💬</a>

<script>
document.getElementById("form").addEventListener("submit", function(e){
  e.preventDefault();
  document.getElementById("popup").style.display="block";

  setTimeout(()=>{
    document.getElementById("popup").style.display="none";
  },3000);
});
</script>

</body>
</html>
