<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deepesh Digital</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<style>
body {
  margin: 0;
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(135deg,#e0f2fe,#fce7f3);
  color: #111;
}

/* HEADER */
header {
  display: flex;
  justify-content: space-between;
  padding: 20px 40px;
  border-bottom: 2px solid #0f172a;
  background: white;
  position: sticky;
  top: 0;
}

.logo {
  font-weight: 600;
  font-size: 22px;
}

/* HERO */
.hero {
  text-align: center;
  padding: 80px 20px;
  animation: fadeIn 1.5s ease-in;
}

.hero h1 {
  font-size: 40px;
}

.btn {
  padding: 12px 25px;
  border-radius: 8px;
  margin: 10px;
  cursor: pointer;
  border: none;
  background: #2563eb;
  color: white;
  transition: 0.3s;
}

.btn:hover {
  transform: scale(1.05);
  background: #1d4ed8;
}

/* SERVICES */
.services {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
  gap: 20px;
  padding: 40px;
}

.card {
  background: white;
  padding: 20px;
  border: 2px solid #0f172a;
  border-radius: 12px;
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-10px);
}

/* SECTION */
section {
  border-bottom: 2px solid #0f172a;
}

/* CONTACT */
form input, form textarea {
  width: 80%;
  padding: 10px;
  margin: 10px;
}

/* FOOTER */
footer {
  text-align: center;
  padding: 20px;
}

/* WHATSAPP */
.whatsapp {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: green;
  padding: 15px;
  border-radius: 50%;
  color: white;
  text-decoration: none;
}

/* POPUP */
.popup {
  position: fixed;
  top: 20px;
  right: 20px;
  background: #22c55e;
  color: white;
  padding: 15px;
  display: none;
}

/* ANIMATION */
@keyframes fadeIn {
  from {opacity: 0;}
  to {opacity: 1;}
}
</style>
</head>

<body>

<header>
  <div class="logo">🤖 DD | Deepesh Digital</div>
</header>

<section class="hero">
  <h1>Grow Your Business Online 🚀</h1>
  <p>Websites | Instagram | Facebook | Lead Generation</p>

  <a href="https://wa.me/919399816768?text=Hi%20I%20want%20digital%20marketing%20service">
    <button class="btn">Chat on WhatsApp</button>
  </a>
</section>

<section>
  <h2 style="text-align:center;">Our Services</h2>
  <div class="services">
    <div class="card">Website Development</div>
    <div class="card">Instagram Page Setup</div>
    <div class="card">Facebook Page Creation</div>
    <div class="card">Business Website Setup</div>
    <div class="card">Lead Generation</div>
  </div>
</section>

<section style="text-align:center; padding:40px;">
  <h2>Why Choose Me</h2>
  <p>✔ 15 Months IT Experience</p>
  <p>✔ Affordable Pricing</p>
  <p>✔ Fast Delivery</p>
  <p>✔ 24/7 Support</p>
</section>

<section style="text-align:center;">
  <h2>Contact Me</h2>

  <form id="leadForm">
    <input type="text" placeholder="Your Name" required><br>
    <input type="text" placeholder="Phone Number" required><br>
    <textarea placeholder="Your Message"></textarea><br>
    <button class="btn">Submit</button>
  </form>
</section>

<div class="popup" id="popup">✅ Enquiry Sent!</div>

<footer>
  © 2026 Deepesh Digital
</footer>

<a class="whatsapp" href="https://wa.me/919399816768?text=Hi%20I%20want%20digital%20marketing%20service">
  💬
</a>

<script>
document.getElementById("leadForm").addEventListener("submit", function(e){
  e.preventDefault();

  document.getElementById("popup").style.display = "block";

  setTimeout(() => {
    document.getElementById("popup").style.display = "none";
  }, 3000);
});
</script>

</body>
</html>
